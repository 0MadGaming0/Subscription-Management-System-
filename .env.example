# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/brightloop_subscriptions

# JSON Web Token Configuration
# Generate a secure secret using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=df200db17acdc89dcf460abf664272abab2b200942c6b29d1af12c56546d0602f5fdef78c6477e10cb97ce06aacab61e174c458abc40808cae0b098cbd30a688
JWT_EXPIRES_IN=24h

# Client / Frontend URL (for CORS and Password Reset Links)
CLIENT_URL=http://localhost:3000

# Email Service Configuration (Nodemailer SMTP)
# For production or development testing (e.g., Mailtrap, SendGrid, Ethereal)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="Brightloop Software <support@brightloop.com>"

# Rate Limiting Configuration (in milliseconds and request counts)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=15
LOGIN_RATE_LIMIT_MAX=5
