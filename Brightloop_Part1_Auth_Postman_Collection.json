{
  "info": {
    "_postman_id": "brightloop-subscription-auth-v1",
    "name": "Brightloop Software - Part 1: Authentication & User Management",
    "description": "Comprehensive Postman test collection for Part 1 of the Brightloop Subscription Management System API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "staffToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "resetToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        },
        "description": "Verifies that the server and database are healthy."
      }
    },
    {
      "name": "1. User Registration",
      "item": [
        {
          "name": "1.1 Success - Customer Registration",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('customerToken', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Customer\",\n  \"email\": \"jane.customer@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Registers a new customer. Returns 201 Created and JWT token."
          }
        },
        {
          "name": "1.2 Failure - Reject Weak Password (Length <= 8)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Weak User\",\n  \"email\": \"weak@example.com\",\n  \"password\": \"Pass1!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Rejects password with <= 8 characters. Returns 400 Bad Request."
          }
        },
        {
          "name": "1.3 Failure - Reject Missing Special Character",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"NoSpecial User\",\n  \"email\": \"nospecial@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Rejects password missing a special character. Returns 400 Bad Request."
          }
        },
        {
          "name": "1.4 Failure - Reject Duplicate Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Duplicate\",\n  \"email\": \"jane.customer@example.com\",\n  \"password\": \"AnotherPass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Rejects registration with duplicate email. Returns 409 Conflict."
          }
        },
        {
          "name": "1.5 Security - Reject Attempted Role Manipulation (Mass Assignment)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Malicious Attacker\",\n  \"email\": \"attacker@example.com\",\n  \"password\": \"HackerPass123!\",\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Attempts to escalate role to admin via public registration. Server forces role to customer."
          }
        }
      ]
    },
    {
      "name": "2. Authentication (Login)",
      "item": [
        {
          "name": "2.1 Success - Customer Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('customerToken', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane.customer@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticates user and returns JWT token."
          }
        },
        {
          "name": "2.2 Failure - Invalid Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane.customer@example.com\",\n  \"password\": \"WrongPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Rejects incorrect password with generic 401 Unauthorized."
          }
        },
        {
          "name": "2.3 Failure - Non-Existent Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nonexistent@brightloop.com\",\n  \"password\": \"SomePass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Rejects unknown email with identical generic 401 message (prevents user enumeration)."
          }
        },
        {
          "name": "2.4 Success - Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('adminToken', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@brightloop.com\",\n  \"password\": \"AdminSecretPass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticates bootstrapped Admin and stores adminToken."
          }
        }
      ]
    },
    {
      "name": "3. User Profile (/me)",
      "item": [
        {
          "name": "3.1 Success - Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Retrieves profile of the authenticated user without exposing password or reset tokens."
          }
        },
        {
          "name": "3.2 Failure - Access Denied Without Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Returns 401 Unauthorized when Authorization header is missing."
          }
        },
        {
          "name": "3.3 Failure - Access Denied With Invalid Token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer invalid_token_value_here"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Returns 401 Unauthorized when token signature is invalid."
          }
        }
      ]
    },
    {
      "name": "4. Admin Operations (Staff Creation)",
      "item": [
        {
          "name": "4.1 Success - Admin Creates Staff Member",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Role is staff', function () { pm.expect(jsonData.user.role).to.eql('staff'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sam Staff\",\n  \"email\": \"sam.staff@brightloop.com\",\n  \"password\": \"StaffSecretPass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/staff",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "staff"]
            },
            "description": "Admin creates a new staff account. Returns 201 Created."
          }
        },
        {
          "name": "4.2 Failure - Customer Cannot Create Staff (403 Forbidden)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Illegal Staff\",\n  \"email\": \"illegal@brightloop.com\",\n  \"password\": \"IllegalPass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/staff",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "staff"]
            },
            "description": "Customer attempts to call staff creation endpoint. Returns 403 Forbidden."
          }
        }
      ]
    },
    {
      "name": "5. Password Reset Flow",
      "item": [
        {
          "name": "5.1 Success - Request Password Reset (Existing User)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane.customer@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "forgot-password"]
            },
            "description": "Dispatches password reset email with 15-minute expiring token. Returns generic 200 OK."
          }
        },
        {
          "name": "5.2 Security - Request Password Reset (Non-existent Email)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"unknown.user@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "forgot-password"]
            },
            "description": "Returns identical generic 200 OK response to prevent email discovery."
          }
        },
        {
          "name": "5.3 Success - Reset Password With Valid Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"NewSecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/reset-password/{{resetToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "reset-password", "{{resetToken}}"]
            },
            "description": "Resets user password with valid unhashed token from email. Invalidate token after first use."
          }
        },
        {
          "name": "5.4 Failure - Reject Invalid or Reused Token (Single-Use Check)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"AnotherPass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/reset-password/{{resetToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "reset-password", "{{resetToken}}"]
            },
            "description": "Attempts to reuse the token. Returns 400 Bad Request (single-use enforced)."
          }
        }
      ]
    }
  ]
}

